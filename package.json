{
  "name": "dsh-ppt-master",
  "description": "DeepSeek Harness plugin: auto-installs and auto-updates the ppt-master project (AI PowerPoint generator) from GitHub on every start",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js",
    "prepack": "node scripts/build.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ppt",
    "powerpoint",
    "ppt-master",
    "presentation"
  ]
}
